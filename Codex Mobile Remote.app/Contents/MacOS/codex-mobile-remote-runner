#!/usr/bin/env bash
set -euo pipefail

APP_EXEC_DIR="$(cd "$(dirname "$0")" && pwd)"
BUNDLE_DIR="$(cd "$APP_EXEC_DIR/../.." && pwd)"
RESOURCE_PAYLOAD="$BUNDLE_DIR/Contents/Resources/codex-mobile-remote.tar.gz"
INSTALL_ROOT="$HOME/Library/Application Support/Codex Mobile Remote"
native_mode=0
if [ "${1:-}" = "--native-runner" ]; then
  native_mode=1
fi

prepare_root_dir() {
  if [ -f "$RESOURCE_PAYLOAD" ]; then
    mkdir -p "$INSTALL_ROOT"
    tar -xzf "$RESOURCE_PAYLOAD" -C "$INSTALL_ROOT"
    ROOT_DIR="$INSTALL_ROOT"
  else
    ROOT_DIR="$(cd "$APP_EXEC_DIR/../../.." && pwd)"
  fi
}

prepare_root_dir
cd "$ROOT_DIR"

title="Codex Mobile Remote"
log_file="/tmp/codex-mobile-remote-app.log"
service_pid=""

dialog() {
  /usr/bin/osascript - "$title" "$1" <<'OSA'
on run argv
  display dialog (item 2 of argv) buttons {"好的"} default button "好的" with title (item 1 of argv)
end run
OSA
}

ask_continue() {
  /usr/bin/osascript - "$title" "$1" <<'OSA'
on run argv
  try
    set picked to button returned of (display dialog (item 2 of argv) buttons {"退出", "重新设置", "继续启动"} default button "继续启动" cancel button "退出" with title (item 1 of argv))
    return picked
  on error number -128
    return "退出"
  end try
end run
OSA
}

prompt() {
  /usr/bin/osascript - "$title" "$1" "$2" <<'OSA'
on run argv
  try
    set answerText to text returned of (display dialog (item 2 of argv) default answer (item 3 of argv) buttons {"取消", "继续"} default button "继续" cancel button "取消" with title (item 1 of argv))
    return answerText
  on error number -128
    return "__CANCEL__"
  end try
end run
OSA
}

choose_token_mode() {
  /usr/bin/osascript - "$title" <<'OSA'
on run argv
  try
    set picked to button returned of (display dialog "设置手机访问口令。\n\n- 无口令：打开网页直接进入，适合只在本机或可信网络使用。\n- 自动生成：更安全，App 会显示给你。\n- 手动输入：自己设一个固定口令。" buttons {"无口令", "自动生成", "手动输入"} default button "自动生成" with title (item 1 of argv))
    return picked
  on error number -128
    return "__CANCEL__"
  end try
end run
OSA
}

control_dialog() {
  /usr/bin/osascript - "$title" "$1" <<'OSA'
on run argv
  try
    set picked to button returned of (display dialog (item 2 of argv) buttons {"停止并退出", "显示地址", "打开本机页面"} default button "打开本机页面" cancel button "停止并退出" with title (item 1 of argv))
    return picked
  on error number -128
    return "停止并退出"
  end try
end run
OSA
}

cancel_if_needed() {
  if [ "${1:-}" = "__CANCEL__" ]; then
    exit 0
  fi
}

shell_quote() {
  printf "'%s'" "$(printf "%s" "$1" | sed "s/'/'\\\\''/g")"
}

random_token() {
  node --input-type=module -e 'import crypto from "node:crypto"; console.log(crypto.randomBytes(18).toString("base64url"))'
}

mac_ip() {
  local ip=""
  if command -v ipconfig >/dev/null 2>&1; then
    ip="$(ipconfig getifaddr en0 2>/dev/null || true)"
    if [ -z "$ip" ]; then
      ip="$(ipconfig getifaddr en1 2>/dev/null || true)"
    fi
  fi
  printf "%s" "$ip"
}

read_config_value() {
  local key="$1"
  local fallback="$2"
  local value=""
  if [ -f ".cmr-config" ]; then
    value="$(sed -n "s/^${key}=//p" .cmr-config | head -n 1 | sed "s/^'//; s/'$//")"
  fi
  if [ -n "$value" ]; then
    printf "%s" "$value"
  else
    printf "%s" "$fallback"
  fi
}

prepend_path_dir() {
  local dir="$1"
  if [ -d "$dir" ]; then
    case ":$PATH:" in
      *":$dir:"*) ;;
      *) PATH="$dir:$PATH" ;;
    esac
  fi
}

bootstrap_node_path() {
  export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"
  prepend_path_dir "$HOME/.volta/bin"
  prepend_path_dir "$HOME/.fnm"
  prepend_path_dir "$HOME/Library/pnpm"

  local dir discovered shell_path
  for dir in "$HOME/.nvm/versions/node"/*/bin "$HOME/.local/share/fnm/node-versions"/*/installation/bin; do
    prepend_path_dir "$dir"
  done

  for shell_path in /bin/zsh /bin/bash; do
    if [ -x "$shell_path" ]; then
      discovered="$("$shell_path" -lic 'command -v node 2>/dev/null || true' 2>/dev/null | tail -n 1)"
      if [ -n "$discovered" ]; then
        prepend_path_dir "$(dirname "$discovered")"
      fi
      discovered="$("$shell_path" -lic 'command -v npm 2>/dev/null || true' 2>/dev/null | tail -n 1)"
      if [ -n "$discovered" ]; then
        prepend_path_dir "$(dirname "$discovered")"
      fi
    fi
  done

  export PATH
}

cleanup() {
  if [ -n "${service_pid:-}" ] && kill -0 "$service_pid" 2>/dev/null; then
    kill "$service_pid" 2>/dev/null || true
    wait "$service_pid" 2>/dev/null || true
  fi
  ./scripts/stop.sh >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

ensure_project() {
  if [ ! -f "package.json" ] || [ ! -d "server" ]; then
    dialog "没有找到项目文件。请把这个 App 放在 codex-mobile-remote 项目根目录里再双击。"
    exit 1
  fi
}

ensure_node() {
  bootstrap_node_path
  if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
    dialog "没有检测到 Node.js / npm。App 已尝试寻找 Homebrew、nvm、Volta 和 fnm 里的 Node。\n\n如果你已经安装 Node，请确认它在 /opt/homebrew/bin、/usr/local/bin，或你的登录 shell 能通过 command -v node 找到。\n\n也可以安装 Node.js 20 或更高版本后再打开这个 App。"
    /usr/bin/open "https://nodejs.org/"
    exit 1
  fi

  node_major="$(node -p 'process.versions.node.split(".")[0]')"
  if [ "$node_major" -lt 20 ]; then
    dialog "当前 Node.js 版本是 $(node -v)，路径是 $(command -v node)。需要 Node.js 20 或更高版本。"
    /usr/bin/open "https://nodejs.org/"
    exit 1
  fi
}

setup_wizard() {
  local default_port default_codex_app port token_mode token codex_app
  default_port="$(read_config_value "PORT" "8088")"
  default_codex_app="$(read_config_value "CODEX_DESKTOP_APP" "/Applications/Codex.app")"

  port="$(prompt "手机网页端口。一般保持默认 8088 即可。" "$default_port")"
  cancel_if_needed "$port"
  if ! [[ "$port" =~ ^[0-9]+$ ]] || [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
    dialog "端口必须是 1 到 65535 之间的数字。"
    exit 1
  fi

  token_mode="$(choose_token_mode)"
  cancel_if_needed "$token_mode"
  case "$token_mode" in
    "无口令")
      token=""
      ;;
    "自动生成")
      token="$(random_token)"
      ;;
    "手动输入")
      token="$(prompt "请输入手机登录口令。留空表示不使用口令。" "")"
      cancel_if_needed "$token"
      ;;
    *)
      exit 0
      ;;
  esac

  codex_app="$(prompt "Codex.app 路径。默认会自动寻找；如果你装在别处，可以在这里填写。" "$default_codex_app")"
  cancel_if_needed "$codex_app"

  printf '%s\n' "$token" > .remote-token
  chmod 600 .remote-token

  cat > .cmr-config <<EOF
PORT=$port
VNC_HOST=127.0.0.1
VNC_PORT=5900
CODEX_DESKTOP_APP=$(shell_quote "$codex_app")
EOF
  chmod 600 .cmr-config
}

ensure_setup() {
  if [ ! -f ".cmr-config" ] || [ ! -f ".remote-token" ]; then
    setup_wizard
    return
  fi

  choice="$(ask_continue "已经有本机配置。\n\n继续启动会使用现有端口和口令；重新设置可以修改端口、口令、Codex.app 路径。")"
  case "$choice" in
    "继续启动") ;;
    "重新设置") setup_wizard ;;
    *) exit 0 ;;
  esac
}

install_dependencies_if_needed() {
  if [ -d "node_modules" ]; then
    return
  fi
  {
    echo "[$(date)] Installing dependencies..."
    npm install
    echo "[$(date)] Fixing script permissions..."
    chmod +x install.sh scripts/*.sh "$0"
  } >"$log_file" 2>&1 || {
    dialog "安装依赖失败。错误日志在：$log_file"
    /usr/bin/open -a Terminal "$log_file" 2>/dev/null || true
    exit 1
  }
}

stop_existing_background_service() {
  ./scripts/stop.sh >/dev/null 2>&1 || true
}

start_service() {
  : > "$log_file"
  ./scripts/run-server.sh >"$log_file" 2>&1 &
  service_pid="$!"

  local port deadline
  port="$(read_config_value "PORT" "8088")"
  deadline=$((SECONDS + 12))
  while [ "$SECONDS" -lt "$deadline" ]; do
    if ! kill -0 "$service_pid" 2>/dev/null; then
      dialog "服务启动失败。错误日志在：$log_file"
      /usr/bin/open -a Terminal "$log_file" 2>/dev/null || true
      exit 1
    fi
    if curl -fsS "http://127.0.0.1:$port/login" >/dev/null 2>&1 || curl -fsS "http://127.0.0.1:$port/" >/dev/null 2>&1; then
      return
    fi
    sleep 0.4
  done

  dialog "服务启动超时。错误日志在：$log_file"
  /usr/bin/open -a Terminal "$log_file" 2>/dev/null || true
  exit 1
}

service_message() {
  local port ip phone_url token_text
  port="$(read_config_value "PORT" "8088")"
  ip="$(mac_ip)"
  if [ -n "$ip" ]; then
    phone_url="http://$ip:$port"
  else
    phone_url="http://<你的Mac局域网IP>:$port"
  fi

  if [ -f ".remote-token" ] && [ -s ".remote-token" ]; then
    token_text="$(cat .remote-token)"
  else
    token_text="无口令，打开网页直接进入"
  fi

  cat <<EOF
服务正在运行。

手机访问地址：
$phone_url

本机页面：
http://localhost:$port

手机登录口令：
$token_text

关闭这个 App 窗口，或点击“停止并退出”，服务就会关闭。
EOF
}

service_ready_line() {
  local port ip phone_url token_text
  port="$(read_config_value "PORT" "8088")"
  ip="$(mac_ip)"
  if [ -n "$ip" ]; then
    phone_url="http://$ip:$port"
  else
    phone_url="http://<你的Mac局域网IP>:$port"
  fi

  if [ -f ".remote-token" ] && [ -s ".remote-token" ]; then
    token_text="$(cat .remote-token)"
  else
    token_text="无口令，打开网页直接进入"
  fi

  printf 'CMR_READY\t%s\t%s\t%s\t%s\n' "$phone_url" "http://localhost:$port" "$token_text" "$log_file"
}

native_wait_loop() {
  service_ready_line
  while [ -n "${service_pid:-}" ] && kill -0 "$service_pid" 2>/dev/null; do
    sleep 1
  done
  exit 1
}

main_loop() {
  local port picked
  port="$(read_config_value "PORT" "8088")"
  while true; do
    picked="$(control_dialog "$(service_message)")"
    case "$picked" in
      "打开本机页面")
        /usr/bin/open "http://localhost:$port"
        ;;
      "显示地址")
        dialog "$(service_message)"
        ;;
      *)
        exit 0
        ;;
    esac
  done
}

ensure_project
ensure_node
ensure_setup
install_dependencies_if_needed
stop_existing_background_service
start_service
if [ "$native_mode" -eq 1 ]; then
  native_wait_loop
else
  main_loop
fi
