#!/usr/bin/env bash
set -euo pipefail

APP_EXEC_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(cd "$APP_EXEC_DIR/../../.." && pwd)"
cd "$ROOT_DIR"

title="Codex Mobile Remote"

dialog() {
  /usr/bin/osascript - "$title" "$1" <<'OSA'
on run argv
  display dialog (item 2 of argv) buttons {"好的"} default button "好的" with title (item 1 of argv)
end run
OSA
}

prompt() {
  /usr/bin/osascript - "$title" "$1" "$2" <<'OSA'
on run argv
  try
    set answerText to text returned of (display dialog (item 2 of argv) default answer (item 3 of argv) buttons {"取消", "继续"} default button "继续" cancel button "取消" with title (item 1 of argv))
    return answerText
  on error number -128
    return "__CANCEL__"
  end try
end run
OSA
}

choose_open() {
  /usr/bin/osascript - "$title" "$1" <<'OSA'
on run argv
  set picked to button returned of (display dialog (item 2 of argv) buttons {"不用", "打开本机页面"} default button "打开本机页面" with title (item 1 of argv))
  return picked
end run
OSA
}

cancel_if_needed() {
  if [ "${1:-}" = "__CANCEL__" ]; then
    exit 0
  fi
}

if [ ! -f "package.json" ] || [ ! -d "server" ]; then
  dialog "没有找到项目文件。请把这个 App 放在 codex-mobile-remote 项目根目录里再双击。"
  exit 1
fi

if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
  dialog "没有检测到 Node.js / npm。请先安装 Node.js 20 或更高版本，然后再打开这个 App。"
  /usr/bin/open "https://nodejs.org/"
  exit 1
fi

node_major="$(node -p 'process.versions.node.split(".")[0]')"
if [ "$node_major" -lt 20 ]; then
  dialog "当前 Node.js 版本是 $(node -v)，需要 Node.js 20 或更高版本。"
  /usr/bin/open "https://nodejs.org/"
  exit 1
fi

default_port="8088"
if [ -f ".cmr-config" ]; then
  existing_port="$(sed -n 's/^PORT=//p' .cmr-config | head -n 1)"
  if [ -n "$existing_port" ]; then
    default_port="$existing_port"
  fi
fi

default_codex_app="/Applications/Codex.app"
if [ -f ".cmr-config" ]; then
  existing_codex_app="$(sed -n 's/^CODEX_DESKTOP_APP=//p' .cmr-config | head -n 1 | sed \"s/^'//; s/'$//\")"
  if [ -n "$existing_codex_app" ]; then
    default_codex_app="$existing_codex_app"
  fi
fi

port="$(prompt "手机网页端口。一般保持默认 8088 即可。" "$default_port")"
cancel_if_needed "$port"
if ! [[ "$port" =~ ^[0-9]+$ ]] || [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
  dialog "端口必须是 1 到 65535 之间的数字。"
  exit 1
fi

default_token=""
if [ -f ".remote-token" ]; then
  default_token="$(cat .remote-token)"
fi

token="$(prompt "手机登录口令。可以自己输入，也可以留空让 App 自动生成。" "$default_token")"
cancel_if_needed "$token"
if [ -z "$token" ]; then
  token="$(node --input-type=module -e 'import crypto from "node:crypto"; console.log(crypto.randomBytes(18).toString("base64url"))')"
fi

codex_app="$(prompt "Codex.app 路径。默认会自动寻找；如果你装在别处，可以在这里填写。" "$default_codex_app")"
cancel_if_needed "$codex_app"

shell_quote() {
  printf "'%s'" "$(printf "%s" "$1" | sed "s/'/'\\\\''/g")"
}

printf '%s\n' "$token" > .remote-token
chmod 600 .remote-token

cat > .cmr-config <<EOF
PORT=$port
VNC_HOST=127.0.0.1
VNC_PORT=5900
CODEX_DESKTOP_APP=$(shell_quote "$codex_app")
EOF
chmod 600 .cmr-config

progress_file="/tmp/codex-mobile-remote-app.log"
{
  echo "[$(date)] Installing dependencies..."
  npm install
  echo "[$(date)] Fixing script permissions..."
  chmod +x install.sh scripts/*.sh
  echo "[$(date)] Starting background service..."
  ./scripts/start-background.sh
} >"$progress_file" 2>&1 || {
  dialog "启动失败。错误日志在：$progress_file"
  /usr/bin/open -a Terminal "$progress_file" 2>/dev/null || true
  exit 1
}

mac_ip=""
if command -v ipconfig >/dev/null 2>&1; then
  mac_ip="$(ipconfig getifaddr en0 2>/dev/null || true)"
  if [ -z "$mac_ip" ]; then
    mac_ip="$(ipconfig getifaddr en1 2>/dev/null || true)"
  fi
fi

if [ -n "$mac_ip" ]; then
  phone_url="http://$mac_ip:$port"
else
  phone_url="http://<你的Mac局域网IP>:$port"
fi

message="已经启动完成。

手机访问地址：
$phone_url

手机登录口令：
$token

本机打开：
http://localhost:$port

如果人在外面，建议用 Tailscale IP 替换局域网 IP。"

choice="$(choose_open "$message")"
if [ "$choice" = "打开本机页面" ]; then
  /usr/bin/open "http://localhost:$port"
fi
